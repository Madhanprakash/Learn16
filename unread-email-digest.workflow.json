      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [440, 0],
      "parameters": {
        "promptType": "define",
        "text": "=From: {{ $json.from?.text || \"unknown\" }}\nSubject: {{ $json.subject || \"(no subject)\" }}\n\n{{ ($json.text || $json.snippet || \"\").slice(0, 4000) }}",
        "options": {
          "systemMessage": "You summarise a single email. Reply with exactly one line of plain text, 20 words maximum. Start with the sender name, then a colon, then the key point or action needed. No greeting, no heading, no bullet, no quotes, no line breaks."
        }
      }
    },
